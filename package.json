{
  "name": "@omicronenergy/oscd-shell",
  "version": "0.0.16",
  "description": "The shell component of OpenSCD, where plugins are loaded and the application is initialized.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-shell.git"
  },
  "keywords": [
    "scl",
    "xml",
    "iec",
    "61850",
    "iec61850",
    "scd",
    "omicronenergy"
  ],
  "author": "OMICRON Electronics GmbH",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-shell/issues"
  },
  "homepage": "https://github.com/OMICRONEnergyOSS/oscd-shell#readme",
  "type": "module",
  "exports": {
    ".": "./dist/foundation.js",
    "./oscd-shell.js": "./dist/oscd-shell.js"
  },
  "files": [
    "/dist/",
    "!/dist/*.spec.*",
    "!/dist/*.test.*"
  ],
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "extract": "lit-localize extract",
    "localize": "lit-localize build",
    "build": "npm run extract && npm run localize && oscd build --analyze",
    "bundle": "npm run extract && npm run localize && oscd bundle --analyze",
    "start": "npm run build && oscd start",
    "start:bundle": "npm run bundle && oscd start-bundle",
    "test": "npm run extract && npm run localize && oscd test",
    "test:watch": "npm run extract && npm run localize && oscd test --watch",
    "analyze": "oscd analyze",
    "doc": "npm run analyze -- --exclude dist && typedoc --out dist/doc src/oscd-shell.ts src/foundation.ts",
    "test:visual": "npm run extract && npm run localize && oscd test --visual",
    "test:update": "npm run extract && npm run localize && oscd test --update",
    "deploy": "npm run bundle && npm run doc && oscd deploy",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@omicronenergy/oscd-background-editv1": "^0.0.7",
    "@omicronenergy/oscd-editor-source": "^0.0.5",
    "@omicronenergy/oscd-menu-commons": "^0.0.1",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-test-utils": "^0.0.11",
    "@omicronenergy/oscd-ui": "^0.0.19",
    "@open-wc/scoped-elements": "^3.0.6",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/oscd-editor": "^1.8.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.3.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.1",
    "@omicronenergy/oscd-tooling": "^0.0.6",
    "@open-wc/dev-server-hmr": "^0.2.0",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@ungap/structured-clone": "^1.3.0",
    "@web/dev-server-polyfill": "^1.0.6",
    "@web/rollup-plugin-html": "^3.1.0",
    "@web/rollup-plugin-import-meta-assets": "^2.3.3",
    "@web/test-runner-playwright": "^0.11.1",
    "@web/test-runner-visual-regression": "^0.10.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "rollup": "^4.60.1",
    "rollup-plugin-copy": "^3.5.0",
    "sinon": "^21.0.3",
    "typedoc": "^0.28.18",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@web/test-runner-playwright": {
      "playwright": "1.59.1"
    }
  },
  "customElements": "custom-elements.json"
}
